# The game selector, a runtime module (included by ../Makefile): selector/src
# plus its own copy of rt.c, linked into one read-only image (sel.ld) and
# packed by tools/mksel.py.  run.py serves build/ghostldr/selector.bin at boot.
SEL_SRCS := $(wildcard selector/src/*.c)
# the network installer (netinst/, rel-netinstall): linked in when it is in
# the tree (test_selector.py builds a test module with a fake: SEL_NET_DIR)
SEL_NET_DIR ?= netinst
SEL_NET_SRCS := $(wildcard $(SEL_NET_DIR)/*.c)
# community memory plans (plansync/, docs/community-plans.md): DNS, HTTPS
# through BearSSL (third_party/bearssl, an archive: only what plansync.c uses
# is linked), GitHub and the collection server
SEL_PS_DIR ?= plansync
SEL_PS_SRCS := $(wildcard $(SEL_PS_DIR)/*.c)
SEL_OBJS := $(patsubst selector/src/%.c,$(OUT)/sel/%.o,$(SEL_SRCS)) $(OUT)/sel/rt.o \
            $(patsubst $(SEL_NET_DIR)/%.c,$(OUT)/sel/netinst_%.o,$(SEL_NET_SRCS)) \
            $(patsubst $(SEL_PS_DIR)/%.c,$(OUT)/sel/ps_%.o,$(SEL_PS_SRCS))
BR_DIR := third_party/bearssl
BR_SRCS := $(shell find $(BR_DIR)/src -name '*.c' 2>/dev/null)
BR_OBJS := $(patsubst $(BR_DIR)/src/%.c,$(OUT)/bearssl/%.o,$(BR_SRCS))
BR_DEFS := -DBR_RDRAND=0 -DBR_USE_URANDOM=0 -DBR_USE_WIN32_RAND=0 -DBR_USE_UNIX_TIME=0 -DBR_USE_WIN32_TIME=0 \
           -DBR_AES_X86NI=0 -DBR_SSE2=0 -DBR_POWER8=0
BR_CFLAGS := $(filter-out -Wall -Wextra -Werror,$(CFLAGS)) -w -fvisibility=hidden -I$(BR_DIR)/inc -I$(BR_DIR)/src \
             -Iplansync/shim $(BR_DEFS)
SEL_FONT := selector/font/notosans.glf
SEL_CFLAGS := $(CFLAGS) -fno-math-errno -Iselector/src $(if $(SEL_NET_SRCS),-I$(SEL_NET_DIR)) -I$(SEL_PS_DIR) \
              -DSEL_FONT_FILE='"$(abspath $(SEL_FONT))"'

$(OUT)/sel/%.o: selector/src/%.c selector/src/sel.h selector/src/plat.h $(HEADERS) include/sel_api.h
	@mkdir -p $(dir $@)
	$(CC) $(SEL_CFLAGS) -c $< -o $@

$(OUT)/sel/netinst_%.o: $(SEL_NET_DIR)/%.c $(wildcard $(SEL_NET_DIR)/*.h) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(SEL_CFLAGS) -c $< -o $@

$(OUT)/bearssl/%.o: $(BR_DIR)/src/%.c
	@mkdir -p $(dir $@)
	@$(CC) $(BR_CFLAGS) -c $< -o $@

$(OUT)/libbearssl.a: $(BR_OBJS)
	@rm -f $@
	$(LLVM)/llvm-ar rcs $@ $(BR_OBJS)

# the collection server's address and key, from this machine (never in git);
# empty: the module shares nothing.  Written only when they change, and kept
# out of every command line.
PS_URL := $(or $(GHOSTLDR_CONTRIB_URL),$(shell cat $(HOME)/.config/ghostldr/contrib-url.txt 2>/dev/null))
PS_KEY := $(or $(GHOSTLDR_CONTRIB_KEY),$(shell cat $(HOME)/.config/ghostldr/contrib.key 2>/dev/null))
$(OUT)/sel/contrib.h: FORCE
	@mkdir -p $(dir $@)
	@printf '#define PS_SHARE_URL "%s"\n#define PS_SHARE_KEY "%s"\n' '$(PS_URL)' '$(PS_KEY)' | cmp -s - $@ || \
	 printf '#define PS_SHARE_URL "%s"\n#define PS_SHARE_KEY "%s"\n' '$(PS_URL)' '$(PS_KEY)' > $@

$(OUT)/sel/ps_%.o: $(SEL_PS_DIR)/%.c $(wildcard $(SEL_PS_DIR)/*.h) $(HEADERS) $(OUT)/sel/contrib.h
	@mkdir -p $(dir $@)
	$(CC) $(SEL_CFLAGS) -I$(BR_DIR)/inc -Iplansync/shim -I$(OUT)/sel $(BR_DEFS) -c $< -o $@

$(OUT)/sel/fontdata.o: $(SEL_FONT)
# the install page it serves (.incbin; regenerated by tools/netinstall_page.py)
$(if $(wildcard $(SEL_NET_DIR)/netinst_sel.c),$(OUT)/sel/netinst_netinst_sel.o: ../data/netinstall.html.gz)

$(OUT)/sel/rt.o: src/rt.c $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# relink when a source file is added or removed (like core.objs and ext.objs)
$(OUT)/sel.objs: FORCE
	@mkdir -p $(dir $@)
	@echo '$(SEL_OBJS)' | cmp -s - $@ || echo '$(SEL_OBJS)' > $@

$(OUT)/selector.elf: $(SEL_OBJS) $(OUT)/sel.objs selector/sel.ld $(if $(SEL_PS_SRCS),$(OUT)/libbearssl.a)
	$(LD) $(LDFLAGS) -T selector/sel.ld -o $@ $(SEL_OBJS) $(if $(SEL_PS_SRCS),$(OUT)/libbearssl.a)

$(OUT)/selector.bin: $(OUT)/selector.elf ../tools/mksel.py
	python3 ../tools/mksel.py --abi $(ABI) $< $@

# ghostldr's version for Settings > About (info.c): git describe, rebuilt when it changes
SEL_VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo unknown)
$(OUT)/sel/version.txt: FORCE
	@mkdir -p $(dir $@)
	@echo '$(SEL_VERSION)' | cmp -s - $@ || echo '$(SEL_VERSION)' > $@
$(OUT)/sel/info.o: $(OUT)/sel/version.txt $(wildcard $(SEL_NET_DIR)/*.h)
$(OUT)/sel/info.o: SEL_CFLAGS += -DGHOSTLDR_VERSION='"$(SEL_VERSION)"'
$(OUT)/sel/ps_plansync_sel.o: $(OUT)/sel/version.txt
$(OUT)/sel/ps_plansync_sel.o: SEL_CFLAGS += -DGHOSTLDR_VERSION='"$(SEL_VERSION)"'
