# The game selector, a runtime module (included by ../Makefile): selector/src
# plus its own copy of rt.c, linked into one read-only image (sel.ld) and
# packed by tools/mksel.py.  run.py serves build/ghostldr/selector.bin at boot.
SEL_SRCS := $(wildcard selector/src/*.c)
# the network installer (netinst/, rel-netinstall): linked in when it is in
# the tree (test_selector.py builds a test module with a fake: SEL_NET_DIR)
SEL_NET_DIR ?= netinst
SEL_NET_SRCS := $(wildcard $(SEL_NET_DIR)/*.c)
SEL_OBJS := $(patsubst selector/src/%.c,$(OUT)/sel/%.o,$(SEL_SRCS)) $(OUT)/sel/rt.o \
            $(patsubst $(SEL_NET_DIR)/%.c,$(OUT)/sel/netinst_%.o,$(SEL_NET_SRCS))
SEL_FONT := selector/font/notosans.glf
SEL_CFLAGS := $(CFLAGS) -fno-math-errno -Iselector/src $(if $(SEL_NET_SRCS),-I$(SEL_NET_DIR)) \
              -DSEL_FONT_FILE='"$(abspath $(SEL_FONT))"'

$(OUT)/sel/%.o: selector/src/%.c selector/src/sel.h selector/src/plat.h $(HEADERS) include/sel_api.h
	@mkdir -p $(dir $@)
	$(CC) $(SEL_CFLAGS) -c $< -o $@

$(OUT)/sel/netinst_%.o: $(SEL_NET_DIR)/%.c $(wildcard $(SEL_NET_DIR)/*.h) $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(SEL_CFLAGS) -c $< -o $@

$(OUT)/sel/fontdata.o: $(SEL_FONT)
# the install page it serves (.incbin; regenerated by tools/netinstall_page.py)
$(if $(wildcard $(SEL_NET_DIR)/netinst_sel.c),$(OUT)/sel/netinst_netinst_sel.o: ../data/netinstall.html.gz)

$(OUT)/sel/rt.o: src/rt.c $(HEADERS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c $< -o $@

# relink when a source file is added or removed (like core.objs and ext.objs)
$(OUT)/sel.objs: FORCE
	@mkdir -p $(dir $@)
	@echo '$(SEL_OBJS)' | cmp -s - $@ || echo '$(SEL_OBJS)' > $@

$(OUT)/selector.elf: $(SEL_OBJS) $(OUT)/sel.objs selector/sel.ld
	$(LD) $(LDFLAGS) -T selector/sel.ld -o $@ $(SEL_OBJS)

$(OUT)/selector.bin: $(OUT)/selector.elf ../tools/mksel.py
	python3 ../tools/mksel.py --abi $(ABI) $< $@

# ghostldr's version for Settings > About (info.c): git describe, rebuilt when it changes
SEL_VERSION := $(shell git describe --tags --always --dirty 2>/dev/null || echo unknown)
$(OUT)/sel/version.txt: FORCE
	@mkdir -p $(dir $@)
	@echo '$(SEL_VERSION)' | cmp -s - $@ || echo '$(SEL_VERSION)' > $@
$(OUT)/sel/info.o: $(OUT)/sel/version.txt $(wildcard $(SEL_NET_DIR)/*.h)
$(OUT)/sel/info.o: SEL_CFLAGS += -DGHOSTLDR_VERSION='"$(SEL_VERSION)"'
