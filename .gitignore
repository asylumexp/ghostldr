# build outputs, fetched dependencies and anything game- or console-derived
build/
__pycache__/
*.pyc
.DS_Store
# never commit game data, executables, dumps or saves
*.elf
*.bin
# except the installer's pump: our own code, built from ghostldr/native/pump
!ghostldr/data/gfs_pump.bin
*.self
*.sprx
*.prx
*.pkg
*.psarc
*.xpps
*.card
*.psu
*.zip
app0/
sdimg_*
